generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("TECHNICIAN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedOrders     WorkOrder[]              @relation("AssignedTo")
  createdOrders      WorkOrder[]              @relation("CreatedBy")
  comments           Comment[]
  photos             Photo[]
  signatures         Signature[]
  checklistItemsDone WorkOrderChecklistItem[]
  usageLogs          AssetUsageLog[]

  // Auditorías
  auditsAsAuditor   Audit[]        @relation("AuditAuditor")
  auditItemsChecked AuditItem[]    @relation("AuditItemChecker")
  capaAssigned      CapaAction[]   @relation("CapaAssigned")
  capaCreated       CapaAction[]   @relation("CapaCreated")
  capaChangeLogs    CapaChangeLog[]
  notifications     Notification[]

  // Flota
  vehicleDriver              Vehicle[]           @relation("VehicleDriver")
  fuelLogsLogged             FuelLog[]           @relation("FuelLoggedBy")
  tripLogsAsDriver           TripLog[]           @relation("TripDriver")
  tripLogsAuthorized         TripLog[]           @relation("TripAuthorizedBy")
  vehicleAssignmentsAsDriver VehicleAssignment[] @relation("AssignmentDriver")
  vehicleAssignmentsCreated  VehicleAssignment[] @relation("AssignmentCreatedBy")

  // OEE
  oeeRecordsOperated OEERecord[]   @relation("OEEOperator")
  oeeRecordsRecorded OEERecord[]   @relation("OEERecordedBy")
  downtimeReported   DowntimeEvent[] @relation("DowntimeReportedBy")

  @@map("users")
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  referenceId String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  read        Boolean  @default(false)
  message     String
  link        String?
  createdAt   DateTime @default(now())

  @@unique([type, referenceId, userId])
  @@map("notifications")
}

model Asset {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  description  String?
  location     String
  area         String
  status       String    @default("OPERATIONAL")
  manufacturer String?
  model        String?
  serialNumber String?
  installDate  DateTime?
  currentHours Float?
  currentCycles Float?
  currentKm    Float?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workOrders       WorkOrder[]
  maintenancePlans MaintenancePlan[]
  usageLogs        AssetUsageLog[]
  oeeRecords       OEERecord[]
  downtimeEvents   DowntimeEvent[]

  @@map("assets")
}

model WorkOrder {
  id             String    @id @default(cuid())
  code           String    @unique @default(cuid())
  title          String
  description    String
  type           String
  status         String    @default("PENDING")
  priority       String    @default("MEDIUM")
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?
  autoGenerated  Boolean   @default(false)
  periodicidad   String?

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  maintenancePlanId String?
  maintenancePlan   MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id])

  // Flota: presente cuando la OT es de mantenimiento vehicular
  vehicleId String?
  vehicle   Vehicle? @relation("VehicleWorkOrders", fields: [vehicleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  Comment[]
  photos    Photo[]
  signature Signature?
  checklist WorkOrderChecklist?

  @@map("work_orders")
}

model MaintenancePlan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   @default("PREVENTIVE")
  triggerType   String   @default("TIME")
  frequency     Int?
  frequencyUnit String?
  usageThreshold Float?
  usageUnit     String?
  nextDue       DateTime?
  lastGenerated DateTime?
  active        Boolean  @default(true)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])

  // Flota: presente cuando el plan es de mantenimiento vehicular
  vehicleId String?
  vehicle   Vehicle? @relation("VehicleMaintenancePlans", fields: [vehicleId], references: [id])

  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("maintenance_plans")
}

model ChecklistTemplate {
  id          String @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  items           ChecklistTemplateItem[]
  maintenancePlans MaintenancePlan[]

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String  @id @default(cuid())
  order       Int
  description String
  required    Boolean @default(false)

  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("checklist_template_items")
}

model WorkOrderChecklist {
  id          String    @id @default(cuid())
  completedAt DateTime?

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  items WorkOrderChecklistItem[]

  @@map("work_order_checklists")
}

model WorkOrderChecklistItem {
  id          String    @id @default(cuid())
  order       Int
  description String
  required    Boolean   @default(false)
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  notes       String?

  checklistId String
  checklist   WorkOrderChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  checkedById String?
  checkedBy   User?   @relation(fields: [checkedById], references: [id])

  @@map("work_order_checklist_items")
}

model Photo {
  id           String @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  phase        String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@map("photos")
}

model Signature {
  id         String   @id @default(cuid())
  data       String
  signerName String
  signedAt   DateTime @default(now())

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  signedById String
  signedBy   User   @relation(fields: [signedById], references: [id])

  @@map("signatures")
}

model AssetUsageLog {
  id       String   @id @default(cuid())
  value    Float
  unit     String
  loggedAt DateTime @default(now())
  notes    String?

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  loggedById String
  loggedBy   User   @relation(fields: [loggedById], references: [id])

  @@map("asset_usage_logs")
}

model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("areas")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// â”€â”€â”€ MÃ³dulo de AuditorÃ­as â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AuditTemplate {
  id        String                 @id @default(cuid())
  name      String
  type      String                 // "FIVE_S" | "PROCESS"
  isDefault Boolean                @default(false)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  sections  AuditTemplateSection[]
  audits    Audit[]

  @@map("audit_templates")
}

model AuditTemplateSection {
  id         String              @id @default(cuid())
  order      Int
  name       String
  isBehavior Boolean             @default(false)
  weight     Float               @default(1.0)

  templateId String
  template   AuditTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items      AuditTemplateItem[]

  @@map("audit_template_sections")
}

model AuditTemplateItem {
  id          String               @id @default(cuid())
  order       Int
  description String
  weight      Float                @default(1.0)

  sectionId String
  section   AuditTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("audit_template_items")
}

model Audit {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  type        String    // "FIVE_S" | "PROCESS"
  status      String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | CLOSED
  area        String
  score       Float?
  notes       String?
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?

  auditorId  String
  auditor    User           @relation("AuditAuditor", fields: [auditorId], references: [id])
  templateId String?
  template   AuditTemplate? @relation(fields: [templateId], references: [id])

  sections    AuditSection[]
  capaActions CapaAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("audits")
}

model AuditSection {
  id         String      @id @default(cuid())
  order      Int
  name       String
  isBehavior Boolean     @default(false)
  weight     Float       @default(1.0)

  auditId String
  audit   Audit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  items   AuditItem[]

  @@map("audit_sections")
}

model AuditItem {
  id          String    @id @default(cuid())
  order       Int
  description String
  weight      Float     @default(1.0)
  result      String?   // "PASS" | "FAIL" | "NA"
  notes       String?
  checkedAt   DateTime?

  sectionId   String
  section     AuditSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  checkedById String?
  checkedBy   User?        @relation("AuditItemChecker", fields: [checkedById], references: [id])

  capaActions CapaAction[]

  @@map("audit_items")
}

model CapaAction {
  id           String    @id @default(cuid())
  code         String    @unique
  type         String    // "CORRECTIVE" | "PREVENTIVE"
  description  String
  rootCause    String?
  severity     String    @default("MINOR") // CRITICAL | MAJOR | MINOR | OBSERVATION
  status       String    @default("OPEN")  // OPEN | IN_PROGRESS | PENDING_VERIFICATION | CLOSED
  dueDate      DateTime
  closedAt     DateTime?
  closingNotes String?

  // 5 Por Qués (análisis de causa raíz guiado)
  why1         String?
  why2         String?
  why3         String?
  why4         String?
  why5         String?

  // Diagrama de Ishikawa
  ishikawaMachine     String?
  ishikawaMethod      String?
  ishikawaMaterial    String?
  ishikawaManpower    String?
  ishikawaEnvironment String?

  // Evidencia fotográfica
  evidencePhotos String? // JSON array de URLs

  auditId     String
  audit       Audit     @relation(fields: [auditId], references: [id])
  auditItemId String?
  auditItem   AuditItem? @relation(fields: [auditItemId], references: [id])

  assignedToId String
  assignedTo   User   @relation("CapaAssigned", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User   @relation("CapaCreated", fields: [createdById], references: [id])

  changeLogs   CapaChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("capa_actions")
}

model CapaChangeLog {
  id        String     @id @default(cuid())
  capaId    String
  capa      CapaAction @relation(fields: [capaId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime   @default(now())

  @@map("capa_change_logs")
}

model Comment {
  id      String @id @default(cuid())
  content String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@map("comments")
}

// ─── Módulo OEE ───────────────────────────────────────────────────────────────

model OEERecord {
  id             String   @id @default(cuid())
  date           DateTime // Fecha del turno (día, sin hora relevante)
  shift          String   // "MORNING" | "AFTERNOON" | "NIGHT"

  // Tiempos en minutos
  plannedTime    Float    // Tiempo programado de producción
  breakTime      Float    @default(0) // Paros planificados (comidas, cambio de turno)

  // Conteos de producción
  totalCount     Int      // Piezas totales producidas (buenas + defectuosas)
  goodCount      Int      // Piezas buenas / conformes
  idealCycleTime Float    // Tiempo de ciclo ideal en min/pieza

  // Componentes OEE calculados por el backend (0–100 %)
  availability   Float?   // (plannedTime - downtimeTotalMin) / plannedTime × 100
  performance    Float?   // (idealCycleTime × totalCount) / actualTime × 100
  quality        Float?   // goodCount / totalCount × 100
  oee            Float?   // availability × performance × quality / 10000

  notes          String?

  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])

  operatorId     String?
  operator       User?    @relation("OEEOperator", fields: [operatorId], references: [id])

  recordedById   String
  recordedBy     User     @relation("OEERecordedBy", fields: [recordedById], references: [id])

  downtimeEvents DowntimeEvent[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([assetId, date, shift])
  @@map("oee_records")
}

model DowntimeEvent {
  id           String    @id @default(cuid())
  startTime    DateTime
  endTime      DateTime?
  duration     Float?    // Minutos; calculado por el backend al cerrar el evento

  // Clasificación según metodología OEE
  category     String    // "PLANNED" | "UNPLANNED" | "SETUP" | "MINOR_STOP"
  lossType     String    // "AVAILABILITY" | "PERFORMANCE" | "QUALITY"
  reason       String    // Causa breve (ej. "Falla eléctrica", "Cambio de molde")
  notes        String?

  oeeRecordId  String
  oeeRecord    OEERecord @relation(fields: [oeeRecordId], references: [id], onDelete: Cascade)

  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id])

  reportedById String
  reportedBy   User      @relation("DowntimeReportedBy", fields: [reportedById], references: [id])

  createdAt    DateTime  @default(now())

  @@map("downtime_events")
}

model OEEMonthlyReport {
  id                String   @id @default(cuid())
  year              Int
  month             Int      // 1–12
  oee               Float
  availability      Float
  performance       Float
  quality           Float
  recordCount       Int
  totalGood         Int
  totalDefects      Int
  totalPlannedHours Float
  byAsset           Json     // Array serializado de resúmenes por activo
  generatedAt       DateTime @default(now())

  @@unique([year, month])
  @@map("oee_monthly_reports")
}

// ─── Módulo de Flota ──────────────────────────────────────────────────────────

model Vehicle {
  id                 String               @id @default(cuid())
  code               String               @unique
  plate              String               @unique
  brand              String
  model              String
  year               Int
  color              String?
  type               String               // "TRUCK" | "VAN" | "CAR" | "FORKLIFT" | "OTHER"
  status             String               @default("AVAILABLE") // "AVAILABLE" | "IN_USE" | "MAINTENANCE" | "OUT_OF_SERVICE"
  fuelType           String               @default("DIESEL") // "DIESEL" | "GASOLINE" | "ELECTRIC" | "HYBRID"
  tankCapacity       Float?
  currentKm          Float                @default(0)
  area               String?
  insuranceExpiry    DateTime?
  verificationExpiry DateTime?
  licenseExpiry      DateTime?
  circulationCard    DateTime?
  driverId           String?
  driver             User?                @relation("VehicleDriver", fields: [driverId], references: [id])
  fuelLogs           FuelLog[]
  tripLogs           TripLog[]
  assignments        VehicleAssignment[]
  // Mantenimiento vehicular — reutiliza modelos de activos
  maintenancePlans   MaintenancePlan[]    @relation("VehicleMaintenancePlans")
  workOrders         WorkOrder[]          @relation("VehicleWorkOrders")
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("vehicles")
}

model FuelLog {
  id            String   @id @default(cuid())
  vehicleId     String
  date          DateTime
  liters        Float
  pricePerLiter Float
  totalCost     Float
  kmAtFuel      Float
  station       String?
  invoiceNumber String?
  notes         String?
  loggedById    String
  createdAt     DateTime @default(now())

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  loggedBy User    @relation("FuelLoggedBy", fields: [loggedById], references: [id])

  @@map("fuel_logs")
}

model TripLog {
  id             String    @id @default(cuid())
  vehicleId      String
  driverId       String
  origin         String
  destination    String
  purpose        String?
  startKm        Float
  endKm          Float?
  distance       Float?
  startTime      DateTime
  endTime        DateTime?
  status         String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  notes          String?
  authorizedById String?

  vehicle      Vehicle @relation(fields: [vehicleId], references: [id])
  driver       User    @relation("TripDriver", fields: [driverId], references: [id])
  authorizedBy User?   @relation("TripAuthorizedBy", fields: [authorizedById], references: [id])

  @@map("trip_logs")
}

model VehicleAssignment {
  id          String    @id @default(cuid())
  vehicleId   String
  driverId    String
  startDate   DateTime
  endDate     DateTime?
  type        String    @default("PERMANENT") // "PERMANENT" | "TEMPORARY"
  notes       String?
  createdById String

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  driver    User    @relation("AssignmentDriver", fields: [driverId], references: [id])
  createdBy User    @relation("AssignmentCreatedBy", fields: [createdById], references: [id])

  @@map("vehicle_assignments")
}
